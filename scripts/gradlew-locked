#!/usr/bin/env sh
# Run Gradle through one machine-wide lock. Agent builds use this so two
# worktrees cannot start two daemons and exhaust the machine's memory.
set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
uid=$(id -u 2>/dev/null || printf 'user')
lock_dir="${LEKTO_GRADLE_LOCK:-${TMPDIR:-/tmp}/lekto-gradle-lock-$uid}"

while ! mkdir "$lock_dir" 2>/dev/null; do
    pid=$(cat "$lock_dir/pid" 2>/dev/null || true)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
        rm -rf "$lock_dir"
        continue
    fi
    printf 'Waiting for the Gradle build holding %s...\n' "$lock_dir" >&2
    sleep 2
done

printf '%s\n' "$$" > "$lock_dir/pid"
cleanup() { rm -rf "$lock_dir"; }
trap cleanup EXIT HUP INT TERM

jvm_args='-Dorg.gradle.jvmargs=-Xmx2g -XX:MaxMetaspaceSize=768m -Dfile.encoding=UTF-8'
kotlin_args='-Pkotlin.daemon.jvmargs=-Xmx1536M'

if command -v ionice >/dev/null 2>&1 && ionice -c3 true 2>/dev/null; then
    ionice -c3 nice -n 10 "$root/gradlew" \
        "$jvm_args" "$kotlin_args" --max-workers=2 "$@"
elif command -v nice >/dev/null 2>&1; then
    nice -n 10 "$root/gradlew" \
        "$jvm_args" "$kotlin_args" --max-workers=2 "$@"
else
    "$root/gradlew" \
        "$jvm_args" "$kotlin_args" --max-workers=2 "$@"
fi
