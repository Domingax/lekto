<?xml version="1.0" encoding="utf-8"?>
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      The launcher mark (issue #177; docs/design.md §5). The background is the
      Light paper as a plain colour, the foreground is the page with its mastery
      spine, and the monochrome layer is the letter Android 13 tints from the
      wallpaper. All three are generated by `tools/icons/mark.sh` from
      `tools/icons/mark/*.svg`; never edit a drawable by hand.

      The background is a colour rather than the theme's paper on purpose: an app
      icon is drawn by the launcher, which knows nothing about the App theme, so
      the mark is fixed to the paper it depicts (ADR-0036 keeps the theme out of
      the icon).
    -->
    <background android:drawable="@color/lekto_paper_light" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
